<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F6FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GESTIÓN DE PROYECTOS"
            android:textColor="#17365D"
            android:textSize="25sp"
            android:textStyle="bold"
            android:layout_marginTop="15dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Registra y administra los proyectos de construcción."
            android:textColor="#687789"
            android:textSize="14sp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="22dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DATOS DEL PROYECTO"
            android:textColor="#17365D"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <Spinner
            android:id="@+id/spClientes"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginBottom="8dp"
            android:backgroundTint="#2874A6"
            android:spinnerMode="dropdown"/>

        <EditText
            android:id="@+id/etNombreProyecto"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Nombre del proyecto"
            android:inputType="textCapSentences"
            android:padding="12dp"
            android:backgroundTint="#2874A6"/>

        <EditText
            android:id="@+id/etTipoObra"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Tipo de obra"
            android:inputType="textCapSentences"
            android:padding="12dp"
            android:backgroundTint="#2874A6"/>

        <EditText
            android:id="@+id/etDescripcion"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:hint="Descripción del proyecto"
            android:gravity="top"
            android:inputType="textMultiLine|textCapSentences"
            android:padding="12dp"
            android:backgroundTint="#2874A6"/>

        <EditText
            android:id="@+id/etPresupuesto"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Presupuesto"
            android:inputType="numberDecimal"
            android:padding="12dp"
            android:backgroundTint="#2874A6"/>

        <EditText
            android:id="@+id/etEstado"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Estado (Pendiente, En ejecución, Finalizado)"
            android:inputType="textCapSentences"
            android:padding="12dp"
            android:backgroundTint="#2874A6"/>

        <EditText
            android:id="@+id/etFechaInicio"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Fecha de inicio (AAAA-MM-DD)"
            android:inputType="date"
            android:padding="12dp"
            android:backgroundTint="#2874A6"/>

        <EditText
            android:id="@+id/etFechaFin"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Fecha de finalización (AAAA-MM-DD)"
            android:inputType="date"
            android:padding="12dp"
            android:backgroundTint="#2874A6"/>

        <TextView
            android:id="@+id/btnRegistrarProyecto"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="18dp"
            android:background="#17365D"
            android:gravity="center"
            android:text="REGISTRAR PROYECTO"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/btnConsultarProyectos"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="12dp"
            android:background="#2874A6"
            android:gravity="center"
            android:text="CONSULTAR PROYECTOS"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/tvResultadoProyectos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:padding="12dp"
            android:textColor="#17365D"
            android:textSize="14sp"
            android:textIsSelectable="true"/>

    </LinearLayout>
</ScrollView>
